# ============================================================
# Fleet Commander — Environment Variables
# ============================================================
# Copy to .env.local for local dev. Never commit real values.

# ------------------------------------------------------------
# Supabase — REQUIRED
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Site URL — REQUIRED in production
# Used by Stripe checkout success/cancel redirects and billing portal.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fleet.bouncebackbrian.com

# ------------------------------------------------------------
# Stripe — REQUIRED for billing
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# Stripe custom payment domain (active: pay.bouncebackbrian.com)
# Configured in Stripe Dashboard → Settings → Custom domains.
NEXT_PUBLIC_STRIPE_PAYMENT_DOMAIN=pay.bouncebackbrian.com

# ------------------------------------------------------------
# Credit / billing portal URL — used by BillingBanner
# ------------------------------------------------------------
NEXT_PUBLIC_CREDIT_URL=https://credit.bouncebackbrian.com

# ------------------------------------------------------------
# Auth mode — REQUIRED
# standalone = Supabase auth only
# ecosystem  = auth-3boost (future)
# ------------------------------------------------------------
NEXT_PUBLIC_AUTH_MODE=standalone

# ------------------------------------------------------------
# 3Boost auth service — future / ecosystem mode
# ------------------------------------------------------------
# AUTH_3BOOST_URL=http://localhost:3100

# ------------------------------------------------------------
# Identity SOR — future / ecosystem mode
# ------------------------------------------------------------
# NEXT_PUBLIC_IDENTITY_SOR_URL=http://localhost:3103
# NEXT_PUBLIC_IDENTITY_INTERNAL_KEY=your-identity-internal-key

# ------------------------------------------------------------
# Integrations — optional
# ------------------------------------------------------------
# SAMSARA_API_TOKEN=your-samsara-token
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Notifications — optional (leave blank = in-app only)
# ------------------------------------------------------------
# NEXT_PUBLIC_TEAMS_WEBHOOK=
# NEXT_PUBLIC_SMS_ENDPOINT=
# NEXT_PUBLIC_EMAIL_ENDPOINT=

# ------------------------------------------------------------
# Notes
# - STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-side only.
# - AUTH_3BOOST_URL is server-side only. Never expose to the browser.
# - NEXT_PUBLIC_IDENTITY_SOR_URL is browser-accessible because
#   getFleetIdentity() runs client-side. In production, proxy through
#   an API route to avoid CORS issues.
# - NEXT_PUBLIC_IDENTITY_INTERNAL_KEY is intentionally browser-exposed
#   here for the dev flow. In production, proxy through an API route.
# ============================================================
