# ============================================================
# Fleet Commander — Environment Variables
# ============================================================
# Copy to .env.local for local dev. Never commit real values.

# ------------------------------------------------------------
# Core_Eco Supabase — auth/session/identity (project: rkwdryneutgyqrnbuwaz)
# Used by: middleware session check, auth-adapter, login page.
# Core_Eco owns: auth.users, profiles, 3B Account IDs, entitlements.
# ------------------------------------------------------------
NEXT_PUBLIC_CORE_ECO_SUPABASE_URL=https://rkwdryneutgyqrnbuwaz.supabase.co
NEXT_PUBLIC_CORE_ECO_ANON_KEY=your-core-eco-anon-key

# ------------------------------------------------------------
# Fleet Commander Supabase — fleet data only (project: goqzhdrmrdlkchmwfiur)
# Used by: all fleet_* table reads/writes, fleet_business_members.
# Fleet owns: fleet data only. Auth calls must NOT use these for identity.
# These vars remain as fallback during Core_Eco env var rollout — once
# NEXT_PUBLIC_CORE_ECO_* are set in all envs, the fallback is moot.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://goqzhdrmrdlkchmwfiur.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-fleet-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-fleet-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-fleet-service-role-key

# ------------------------------------------------------------
# Site URL — REQUIRED in production
# Used by Stripe checkout success/cancel redirects and billing portal.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fleet.bouncebackbrian.com

# ------------------------------------------------------------
# Stripe — REQUIRED for billing
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# Stripe custom payment domain (active: pay.bouncebackbrian.com)
# Configured in Stripe Dashboard → Settings → Custom domains.
NEXT_PUBLIC_STRIPE_PAYMENT_DOMAIN=pay.bouncebackbrian.com

# ------------------------------------------------------------
# Credit / billing portal URL — used by BillingBanner
# ------------------------------------------------------------
NEXT_PUBLIC_CREDIT_URL=https://credit.bouncebackbrian.com

# ------------------------------------------------------------
# Auth mode — REQUIRED
# standalone = Fleet-local Supabase auth (default, works today)
# ecosystem  = auth-3boost IdP (future)
# ------------------------------------------------------------
NEXT_PUBLIC_AUTH_MODE=standalone

# ------------------------------------------------------------
# Login URL — where unauthenticated users are redirected.
# Unset = Fleet's own /login page (standalone mode, works today).
# Set to https://3boost.bouncebackbrian.com/login when 3Boost
# is live and correctly handles the returnTo param.
# ------------------------------------------------------------
# NEXT_PUBLIC_LOGIN_URL=https://3boost.bouncebackbrian.com/login

# ------------------------------------------------------------
# 3Boost auth service — future / ecosystem mode
# ------------------------------------------------------------
# AUTH_3BOOST_URL=http://localhost:3100

# ------------------------------------------------------------
# Identity SOR — future / ecosystem mode
# ------------------------------------------------------------
# NEXT_PUBLIC_IDENTITY_SOR_URL=http://localhost:3103
# NEXT_PUBLIC_IDENTITY_INTERNAL_KEY=your-identity-internal-key

# ------------------------------------------------------------
# Integrations — optional
# ------------------------------------------------------------
# SAMSARA_API_TOKEN=your-samsara-token
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Notifications — optional (leave blank = in-app only)
# ------------------------------------------------------------
# NEXT_PUBLIC_TEAMS_WEBHOOK=
# NEXT_PUBLIC_SMS_ENDPOINT=
# NEXT_PUBLIC_EMAIL_ENDPOINT=

# ------------------------------------------------------------
# Notes
# - STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-side only.
# - AUTH_3BOOST_URL is server-side only. Never expose to the browser.
# - NEXT_PUBLIC_IDENTITY_SOR_URL is browser-accessible because
#   getFleetIdentity() runs client-side. In production, proxy through
#   an API route to avoid CORS issues.
# - NEXT_PUBLIC_IDENTITY_INTERNAL_KEY is intentionally browser-exposed
#   here for the dev flow. In production, proxy through an API route.
# ============================================================
