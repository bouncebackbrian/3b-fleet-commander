# Copy to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# REQUIRED for load board server-side routes
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Auth mode: standalone (Supabase) | ecosystem (auth-3boost, future)
NEXT_PUBLIC_AUTH_MODE=standalone

# Notifications (leave blank = in-app only)
# NEXT_PUBLIC_TEAMS_WEBHOOK=
# NEXT_PUBLIC_SMS_ENDPOINT=
# NEXT_PUBLIC_EMAIL_ENDPOINT=
# NEXT_PUBLIC_LOVEFINDER_ENDPOINT=
