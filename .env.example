# ============================================================
# Fleet Commander — Environment Variables
# ============================================================
# Copy to .env.local for local dev. Never commit real values.

# ------------------------------------------------------------
# Supabase — REQUIRED
# Fleet operational database.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Core 3Boost / Core_Eco identity database.
# Core owns login, people, businesses, and permanent 3B IDs.
# NEXT_PUBLIC_CORE_ECO_SUPABASE_URL=https://your-core-project.supabase.co
# NEXT_PUBLIC_CORE_ECO_ANON_KEY=your-core-anon-key

# ------------------------------------------------------------
# Site URLs
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fleet.bouncebackbrian.com
# Parent 3Boost application. Fleet Commander returns users here for
# ecosystem dashboard/business creation instead of creating businesses itself.
NEXT_PUBLIC_3BOOST_URL=https://3boost.bouncebackbrian.com

# ------------------------------------------------------------
# Stripe — REQUIRED for billing
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# Stripe custom payment domain (active: pay.bouncebackbrian.com)
# Configured in Stripe Dashboard → Settings → Custom domains.
NEXT_PUBLIC_STRIPE_PAYMENT_DOMAIN=pay.bouncebackbrian.com

# ------------------------------------------------------------
# Credit / billing portal URL — used by BillingBanner
# ------------------------------------------------------------
NEXT_PUBLIC_CREDIT_URL=https://credit.bouncebackbrian.com

# ------------------------------------------------------------
# Auth mode
# ------------------------------------------------------------
# ecosystem = Core 3Boost owns auth/identity; Fleet consumes the shared session.
# standalone remains available only as a local/dev fallback.
NEXT_PUBLIC_AUTH_MODE=ecosystem

# Login URL — Core 3Boost login in production.
# NEXT_PUBLIC_LOGIN_URL=https://3boost.bouncebackbrian.com/login

# 3Boost auth service — optional server-side service endpoint.
# AUTH_3BOOST_URL=http://localhost:3100

# ------------------------------------------------------------
# Integrations — optional
# ------------------------------------------------------------
# SAMSARA_API_TOKEN=your-samsara-token
OPENAI_API_KEY=sk-...                    # Required for AI co-pilot + OCR
# ANTHROPIC_API_KEY=sk-ant-...           # Alternative AI provider

# Spotify — required for music integration
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ------------------------------------------------------------
# Fuel Finder — OPTIONAL / PLACEHOLDERS
# ------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=
# HERE_API_KEY=
# FUEL_PRICE_API_URL=
# FUEL_PRICE_API_KEY=
# TRUCK_STOP_API_URL=
# TRUCK_STOP_API_KEY=

# Twilio — optional SMS emergency alerts
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# EMERGENCY_SMS_NUMBERS=+1xxx,+1xxx

# ------------------------------------------------------------
# Notifications — optional (leave blank = in-app only)
# ------------------------------------------------------------
# NEXT_PUBLIC_SMS_ENDPOINT=
# NEXT_PUBLIC_EMAIL_ENDPOINT=

# ------------------------------------------------------------
# Resend — completed digital dispatch tickets
# ------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Fleet Commander <tickets@yourdomain.com>

# ------------------------------------------------------------
# Supabase Edge Functions
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# ------------------------------------------------------------
# Notes
# - Core 3Boost is the source of truth for users/businesses/3B IDs.
# - Fleet Commander is the source of truth for operational Fleet records.
# - Business creation belongs in 3Boost; Fleet receives a permanent Core business ID
#   and provisions access through /api/fleet/provision-business.
# - Server-side secrets must never use NEXT_PUBLIC_*.
# ============================================================