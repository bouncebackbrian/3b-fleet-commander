# ============================================================
# Fleet Commander — Environment Variables
# ============================================================
# Copy to .env.local for local dev. Never commit real values.

# ------------------------------------------------------------
# Supabase — REQUIRED
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Site URL — REQUIRED in production
# Used by Stripe checkout success/cancel redirects and billing portal.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fleet.bouncebackbrian.com

# ------------------------------------------------------------
# Stripe — REQUIRED for billing
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# Stripe custom payment domain (active: pay.bouncebackbrian.com)
# Configured in Stripe Dashboard → Settings → Custom domains.
NEXT_PUBLIC_STRIPE_PAYMENT_DOMAIN=pay.bouncebackbrian.com

# ------------------------------------------------------------
# Credit / billing portal URL — used by BillingBanner
# ------------------------------------------------------------
NEXT_PUBLIC_CREDIT_URL=https://credit.bouncebackbrian.com

# ------------------------------------------------------------
# Auth mode — REQUIRED
# standalone = Fleet-local Supabase auth (default, works today)
# ecosystem  = auth-3boost IdP (future)
# ------------------------------------------------------------
NEXT_PUBLIC_AUTH_MODE=standalone

# ------------------------------------------------------------
# Login URL — where unauthenticated users are redirected.
# Unset = Fleet's own /login page (standalone mode, works today).
# Set to https://3boost.bouncebackbrian.com/login when 3Boost
# is live and correctly handles the returnTo param.
# ------------------------------------------------------------
# NEXT_PUBLIC_LOGIN_URL=https://3boost.bouncebackbrian.com/login

# ------------------------------------------------------------
# 3Boost auth service — future / ecosystem mode
# ------------------------------------------------------------
# AUTH_3BOOST_URL=http://localhost:3100

# ------------------------------------------------------------
# Identity SOR — future / ecosystem mode
# ------------------------------------------------------------
# NEXT_PUBLIC_IDENTITY_SOR_URL=http://localhost:3103
# NEXT_PUBLIC_IDENTITY_INTERNAL_KEY=your-identity-internal-key

# ------------------------------------------------------------
# Integrations — optional
# ------------------------------------------------------------
# SAMSARA_API_TOKEN=your-samsara-token
OPENAI_API_KEY=sk-...                    # Required for AI co-pilot + OCR
# ANTHROPIC_API_KEY=sk-ant-...           # Alternative AI provider

# Spotify — required for music integration
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ------------------------------------------------------------
# Fuel Finder — OPTIONAL / PLACEHOLDERS
# Fuel Finder remains disabled/provider-placeholder until credentials exist.
# Never expose these server-side keys through NEXT_PUBLIC_* variables.
# ------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=                   # Places station search + fuelOptions/fuelPrices where available
# HERE_API_KEY=                          # Truck-aware routing, detour miles/minutes, traffic
# FUEL_PRICE_API_URL=                    # Optional commercial/secondary fuel-price feed
# FUEL_PRICE_API_KEY=
# TRUCK_STOP_API_URL=                    # Optional truck-stop/DEF/parking/scale metadata provider
# TRUCK_STOP_API_KEY=

# Twilio — required for SMS emergency alerts
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# EMERGENCY_SMS_NUMBERS=+1xxx,+1xxx    # Comma-separated fallback numbers

# ------------------------------------------------------------
# Notifications — optional (leave blank = in-app only)
# ------------------------------------------------------------
# NEXT_PUBLIC_TEAMS_WEBHOOK=   # DEPRECATED — do not use. Teams delivery is now
#   per-business, server-side only, configured under Dump Truck Setup →
#   Microsoft Teams (fleet_teams_channels table). A NEXT_PUBLIC_* var can
#   never hold a webhook secret safely since it ships to every client.
# NEXT_PUBLIC_SMS_ENDPOINT=
# NEXT_PUBLIC_EMAIL_ENDPOINT=

# ------------------------------------------------------------
# Resend — required to email completed digital dispatch tickets
# (PDF/storage/download all work without it — this only skips the
# "and also email it" step). Free tier at resend.com.
# ------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Fleet Commander <tickets@yourdomain.com>

# ------------------------------------------------------------
# Supabase Edge Functions — Deno runtime URLs
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# ------------------------------------------------------------
# Notes
# - STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-side only.
# - AUTH_3BOOST_URL is server-side only. Never expose to the browser.
# - NEXT_PUBLIC_IDENTITY_SOR_URL is browser-accessible because
#   getFleetIdentity() runs client-side. In production, proxy through
#   an API route to avoid CORS issues.
# - NEXT_PUBLIC_IDENTITY_INTERNAL_KEY is intentionally browser-exposed
#   here for the dev flow. In production, proxy through an API route.
# - OPENAI_API_KEY is server-side only. Call edge functions from client.
# - SPOTIFY_CLIENT_ID/SPOTIFY_CLIENT_SECRET are server-side only.
# - Fuel Finder provider keys are server-side only.
# ============================================================