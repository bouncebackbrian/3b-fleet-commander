# ============================================================
# Fleet Commander — Environment Variables
# ============================================================
# Copy to .env.local for local dev. Never commit real values.

# ------------------------------------------------------------
# Supabase — REQUIRED
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional alias used by some paths:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ------------------------------------------------------------
# 3Boost auth service — REQUIRED in production
# Used by getThreeBSession() to resolve billing state + entitlements.
# Defaults to http://localhost:3100 in local dev if unset.
# ------------------------------------------------------------
AUTH_3BOOST_URL=http://localhost:3100

# ------------------------------------------------------------
# Identity SOR — REQUIRED in production
# Used by getFleetIdentity() slow path (first visit / stale token).
# Defaults to http://localhost:3103 in local dev if unset.
# NEXT_PUBLIC_* so the client-side identity adapter can reach it.
# ------------------------------------------------------------
NEXT_PUBLIC_IDENTITY_SOR_URL=http://localhost:3103
NEXT_PUBLIC_IDENTITY_INTERNAL_KEY=your-identity-internal-key

# ------------------------------------------------------------
# Samsara (fleet telematics) — optional
# ------------------------------------------------------------
SAMSARA_API_TOKEN=your-samsara-token

# ------------------------------------------------------------
# OpenAI (AI features) — optional
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------
# Notes
# - AUTH_3BOOST_URL is server-side only. Never expose to the browser.
# - NEXT_PUBLIC_IDENTITY_SOR_URL is browser-accessible because
#   getFleetIdentity() runs client-side. Ensure the identity-sor
#   service is reachable from the browser origin in production,
#   or proxy it through a Next.js API route to avoid CORS issues.
# - NEXT_PUBLIC_IDENTITY_INTERNAL_KEY is intentionally browser-exposed
#   here for the dev flow. In production, proxy through an API route
#   so the internal key stays server-side.
# ============================================================
